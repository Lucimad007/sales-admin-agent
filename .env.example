# Postgres (docker-compose default)
DATABASE_URL=postgres://sales:sales@localhost:55432/sales_admin

# NestJS API
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_NAME=sales_admin_token

# Internal service auth (Nest <-> LangGraph)
AGENT_URL=http://localhost:8100
AGENT_INTERNAL_TOKEN=change-me-agent-internal-token

# OpenCode Go — DeepSeek V4.1 Flash
AGENT_PORT=8100
OPENCODE_GO_API_KEY=
LLM_MODEL=deepseek-v4.1-flash
LLM_BASE_URL=https://opencode.ai/zen/go/v1

# LangSmith traces (optional)
LANGSMITH_API_KEY=
LANGCHAIN_PROJECT=ledger-tally
