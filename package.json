{
  "name": "sales-admin-agent",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "db:generate": "pnpm --filter @sales/db generate",
    "db:migrate": "pnpm --filter @sales/db migrate",
    "db:seed": "pnpm --filter @sales/db seed",
    "db:studio": "pnpm --filter @sales/db studio"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  }
}
